<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda 4×4, „Senin" (design/android-widget/index.html). Compactul 4×2: widget_agenda_compact.
     Numai clase permise în RemoteViews: fără View simplu (distanțierul e un FrameLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:clipToOutline="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="14dp">
        <!-- Steaua + „Azi" + numărul: atingerea deschide aplicația. -->
        <LinearLayout android:id="@+id/w_brand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widget_star"
                android:tint="@color/w_star" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="Azi" android:fontFamily="sans-serif" android:textStyle="bold"
                android:textSize="24sp" android:letterSpacing="-0.02" android:textColor="@color/w_ink" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum" android:textSize="15sp" android:textColor="@color/w_ink3" />
        </LinearLayout>
        <ImageView android:id="@+id/w_refresh" android:layout_width="34dp" android:layout_height="34dp" android:padding="8.5dp"
            android:background="@drawable/w_ripple_oval" android:src="@drawable/ic_widget_refresh" android:tint="@color/w_ink3"
            android:contentDescription="Reîmprospătează" />
        <ImageView android:id="@+id/w_add" android:layout_width="38dp" android:layout_height="38dp" android:padding="9dp"
            android:layout_marginStart="6dp" android:background="@drawable/widget_quick_bg" android:src="@drawable/ic_widget_plus"
            android:tint="@color/w_on_accent" android:contentDescription="Adaugă" />
    </LinearLayout>

    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="46dp" android:paddingEnd="16dp" android:paddingTop="3dp" android:paddingBottom="4dp"
        android:fontFamily="sans-serif-medium" android:textSize="13sp" android:textColor="@color/w_ink3" android:maxLines="1" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:scrollbars="none" android:paddingBottom="10dp" android:clipToPadding="false" />
        <!-- Neclicabil: atingerea trece la listă. -->
        <ImageView android:id="@+id/w_fade" android:layout_width="match_parent" android:layout_height="28dp"
            android:layout_gravity="bottom" android:src="@drawable/w_fade" android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <LinearLayout android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="12dp" android:paddingBottom="24dp" android:visibility="gone">
            <ImageView android:id="@+id/w_empty_icon" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
                android:layout_marginBottom="10dp" android:background="@drawable/w_soft_oval" android:src="@drawable/ic_widget_check"
                android:tint="@color/w_accent" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textSize="16sp"
                android:textColor="@color/w_ink" />
            <TextView android:id="@+id/w_empty_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center" android:fontFamily="sans-serif-medium" android:textSize="13.5sp"
                android:textColor="@color/w_ink3" />
            <TextView android:id="@+id/w_empty_btn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp"
                android:paddingBottom="8dp" android:background="@drawable/w_btn_soft" android:text="Deschide Horizontal"
                android:fontFamily="sans-serif-medium" android:textSize="13sp" android:textColor="@color/w_accent_ink"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
