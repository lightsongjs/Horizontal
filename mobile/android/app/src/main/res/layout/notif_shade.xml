<?xml version="1.0" encoding="utf-8"?>
<!--
  Notificarea fixă din bară (D-185, `Shade.kt`): numărul de azi, prima sarcină, „+".
  Pe 12+ conținutul unei notificări decorate are cel mult ~48dp în forma strânsă:
  rândul încape în 40dp. Textul pe stilurile de notificare ale sistemului, ca să
  urmeze fundalul barei (HyperOS îl alege singur); doar bulina și „+" sunt „Senin".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="40dp" android:orientation="horizontal" android:gravity="center_vertical">

    <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/w_soft_oval">
        <TextView android:id="@+id/n_count" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:fontFamily="sans-serif-medium" android:textStyle="bold"
            android:fontFeatureSettings="tnum" android:textSize="14sp" android:textColor="@color/w_accent_ink"
            android:includeFontPadding="false" android:maxLines="1" />
        <ImageView android:id="@+id/n_star" android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center"
            android:src="@drawable/ic_widget_star" android:tint="@color/w_star" android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:orientation="vertical">
        <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/n_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <ImageView android:id="@+id/n_add" android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp"
        android:background="@drawable/widget_quick_bg" android:src="@drawable/ic_widget_plus"
        android:tint="@color/w_on_accent" android:contentDescription="Adaugă o sarcină" />
</LinearLayout>
