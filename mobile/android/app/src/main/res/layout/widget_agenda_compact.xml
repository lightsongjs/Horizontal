<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda 4×2: antet scurt (fără dată și fără reîmprospătare), rânduri pe o linie. Aceleași id-uri ca widget_agenda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:clipToOutline="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="12dp" android:paddingBottom="4dp">
        <LinearLayout android:id="@+id/w_brand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_star"
                android:tint="@color/w_star" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:text="Azi" android:fontFamily="sans-serif" android:textStyle="bold"
                android:textSize="19sp" android:letterSpacing="-0.02" android:textColor="@color/w_ink" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum" android:textSize="13.5sp" android:textColor="@color/w_ink3" />
        </LinearLayout>
        <ImageView android:id="@+id/w_add" android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp"
            android:background="@drawable/widget_quick_bg" android:src="@drawable/ic_widget_plus"
            android:tint="@color/w_on_accent" android:contentDescription="Adaugă" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:scrollbars="none" android:paddingBottom="8dp" android:clipToPadding="false" />
        <ImageView android:id="@+id/w_fade" android:layout_width="match_parent" android:layout_height="22dp"
            android:layout_gravity="bottom" android:src="@drawable/w_fade" android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <LinearLayout android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingBottom="12dp" android:visibility="gone">
            <TextView android:id="@+id/w_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textSize="15sp"
                android:textColor="@color/w_ink" />
            <TextView android:id="@+id/w_empty_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center" android:fontFamily="sans-serif-medium" android:textSize="13sp"
                android:textColor="@color/w_ink3" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
