<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false": copia de rezervă ar duce `hz-plan` (titluri în clar) pe
         serverele Google și o sesiune care pe alt telefon nu se mai decriptează (cheia
         Keystore nu pleacă odată cu ea). Reinstalarea cere oricum login. -->
    <application
        android:name=".HorizontalApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Foaia „Amână…": deschisă din notificare, fără WebView; nu rămâne în Recente și nu se lipește de sarcina aplicației. -->
        <activity android:name=".SnoozeActivity" android:exported="false" android:theme="@style/Hz.Snooze"
            android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleInstance" />

        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <!-- Exportat fiindcă sistemul îl cheamă; acțiunile din filtru sunt toate protejate (doar sistemul le poate trimite). -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- „Fă o poză" (`<input capture>`): Capacitor (BridgeWebChromeClient) pornește
         camera cu ACTION_IMAGE_CAPTURE doar dacă `resolveActivity` o găsește, iar de la
         targetSdk 30 vizibilitatea pachetelor o ascunde fără declarația asta — atunci
         cade, cu un avertisment în logcat, pe alegătorul de fișiere. Fără permisiunea
         CAMERA, deliberat: declarată, Capacitor ar cere-o la runtime; nedeclarată,
         aplicația de cameră face poza, iar noi doar primim fișierul. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sideload (spec, „Distribuția"): acordată la instalare pe 13+, omul n-o poate retrage. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Doar Android 12: acolo USE_EXACT_ALARM nu există. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
