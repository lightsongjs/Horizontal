{
  "name": "horizontal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first project-planning tool for developers — dependency layers + delivery waves.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop:install": "npm --prefix desktop install && npm --prefix desktop run app:install",
    "desktop:uninstall": "npm --prefix desktop run app:uninstall",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "test:upgrade": "node scripts/test-upgrade-path.mjs",
    "storage:bucket": "node scripts/create-attachments-bucket.mjs",
    "test:shrink": "node scripts/test-shrink-image.mjs",
    "storage:report": "node scripts/storage-report.mjs",
    "migrate": "node scripts/apply-migration.mjs",
    "vapid": "node scripts/generate-vapid.mjs",
    "test:chime": "node scripts/test-chime.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "test:nav": "node scripts/test-nav.mjs",
    "test:quick-add": "node scripts/test-quick-add.mjs",
    "test:recurrence-sql": "node scripts/test-recurrence-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^17.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.43.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260703.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.61.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
